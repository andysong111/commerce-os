{
  "manifest_version": 3,
  "name": "Commerce OS · Shopling Stock State Sync",
  "short_name": "Stock State Sync",
  "version": "0.1.0",
  "description": "Commerce OS 품절 0 기준점과 입고확정에 따라 Shopling A6·A22 또는 A6·A21을 직렬 실행해 품절/판매중 상태를 동기화합니다.",
  "permissions": ["storage", "tabs", "windows", "scripting", "webNavigation", "alarms"],
  "host_permissions": [
    "https://a.shopling.co.kr/*",
    "https://commerce-os-ops-center.vercel.app/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_title": "Shopling 품절·판매중 동기화",
    "default_popup": "popup.html"
  },
  "content_scripts": [
    {
      "matches": ["https://commerce-os-ops-center.vercel.app/*"],
      "js": ["content-ops.js"],
      "run_at": "document_start"
    },
    {
      "matches": ["https://a.shopling.co.kr/*"],
      "js": ["main-shopling.js"],
      "world": "MAIN",
      "all_frames": true,
      "run_at": "document_start"
    },
    {
      "matches": ["https://a.shopling.co.kr/*"],
      "js": ["content-shopling.js"],
      "all_frames": true,
      "run_at": "document_idle"
    }
  ]
}
