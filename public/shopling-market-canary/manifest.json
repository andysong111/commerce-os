{
  "manifest_version": 3,
  "name": "Commerce OS Shopling Market Canary",
  "short_name": "Shopling Canary",
  "version": "0.1.4",
  "description": "DM1→도매1 한 건만 대상으로 실제 Shopling 수동 등록 경로를 그대로 따라가며, A18 내부 프레임에서도 테스트 버튼을 안정적으로 표시합니다.",
  "permissions": [
    "storage"
  ],
  "host_permissions": [
    "https://a.shopling.co.kr/*",
    "https://commerce-os-ops-center.vercel.app/*"
  ],
  "background": {
    "service_worker": "background-root.mjs"
  },
  "content_scripts": [
    {
      "matches": [
        "https://a.shopling.co.kr/*"
      ],
      "js": [
        "content-market-canary.mjs"
      ],
      "all_frames": true,
      "match_about_blank": true,
      "run_at": "document_idle"
    }
  ]
}
