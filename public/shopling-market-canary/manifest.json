{
  "manifest_version": 3,
  "name": "Commerce OS Shopling Market Canary",
  "short_name": "Shopling Canary",
  "version": "0.1.2",
  "description": "DM1→도매1 한 건만 대상으로 사용자가 실제로 쓰는 Shopling 수동 등록 경로를 그대로 따라 실제 마켓 송신 가능 여부를 검증합니다.",
  "permissions": [
    "storage"
  ],
  "host_permissions": [
    "https://a.shopling.co.kr/*",
    "https://commerce-os-ops-center.vercel.app/*"
  ],
  "background": {
    "service_worker": "background-root.js"
  },
  "content_scripts": [
    {
      "matches": [
        "https://a.shopling.co.kr/*"
      ],
      "js": [
        "content-market-canary.js"
      ],
      "all_frames": true,
      "match_about_blank": true,
      "run_at": "document_idle"
    }
  ]
}
