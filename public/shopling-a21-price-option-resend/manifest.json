{
  "manifest_version": 3,
  "name": "Commerce OS · Shopling A21 Price/Option Resend",
  "short_name": "A21 Resend",
  "version": "0.3.4",
  "description": "Shopling A21 판매가/옵션 직렬 전송. 중복 송신을 차단하고 Shopling form target 결과창을 직접 확보·자동 스크롤해 완료 footer 확인 후 다음 작업으로 진행합니다.",
  "permissions": ["storage", "tabs", "windows", "scripting", "webNavigation"],
  "host_permissions": [
    "https://a.shopling.co.kr/*",
    "https://commerce-os-ops-center.vercel.app/*"
  ],
  "background": {
    "service_worker": "background-v034.js"
  },
  "action": {
    "default_title": "Shopling A21 가격·옵션 수정전송",
    "default_popup": "popup-run.html"
  },
  "content_scripts": [
    {
      "matches": ["https://a.shopling.co.kr/*"],
      "exclude_matches": ["https://a.shopling.co.kr/prodlinkage/goods_mallMdfy_trsmt.phtml*"],
      "js": ["content-a21.js"],
      "all_frames": true,
      "run_at": "document_idle"
    },
    {
      "matches": ["https://a.shopling.co.kr/prodlinkage/goods_mallMdfy_trsmt.phtml*"],
      "js": ["main-result-bridge-v034.js", "main-a21-v024.js"],
      "world": "MAIN",
      "all_frames": true,
      "run_at": "document_start"
    },
    {
      "matches": ["https://a.shopling.co.kr/prodlinkage/goods_mallMdfy_trsmt.phtml*"],
      "js": ["result-relay-v034.js", "content-a21-v024.js"],
      "all_frames": true,
      "run_at": "document_idle"
    }
  ]
}
