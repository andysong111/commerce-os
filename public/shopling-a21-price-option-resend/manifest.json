{
  "manifest_version": 3,
  "name": "Commerce OS · Shopling A21 Price/Option Resend",
  "short_name": "A21 Resend",
  "version": "0.4.2",
  "description": "Shopling A21 판매가/옵션 직렬 전송. 판매가 결과표가 일부 보이는 시점에는 다음 단계로 넘어가지 않고 최종 완료 footer와 document complete까지 확인한 뒤 옵션전송합니다.",
  "permissions": ["storage", "tabs", "windows", "scripting", "webNavigation", "debugger"],
  "host_permissions": [
    "https://a.shopling.co.kr/*",
    "https://commerce-os-ops-center.vercel.app/*"
  ],
  "background": {
    "service_worker": "background-v042.js"
  },
  "action": {
    "default_title": "Shopling A21 가격·옵션 수정전송",
    "default_popup": "popup-run.html"
  },
  "content_scripts": [
    {
      "matches": ["https://a.shopling.co.kr/*"],
      "exclude_matches": ["https://a.shopling.co.kr/prodlinkage/goods_mallMdfy_trsmt.phtml*"],
      "js": ["content-a21.js"],
      "all_frames": true,
      "run_at": "document_idle"
    },
    {
      "matches": ["https://a.shopling.co.kr/prodlinkage/goods_mallMdfy_trsmt.phtml*"],
      "js": ["main-a21-v024.js"],
      "world": "MAIN",
      "all_frames": true,
      "run_at": "document_start"
    },
    {
      "matches": ["https://a.shopling.co.kr/prodlinkage/goods_mallMdfy_trsmt.phtml*"],
      "js": ["content-a21-v024.js"],
      "all_frames": true,
      "run_at": "document_idle"
    }
  ]
}
