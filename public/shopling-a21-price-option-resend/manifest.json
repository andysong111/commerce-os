{
  "manifest_version": 3,
  "name": "Commerce OS · Shopling A21 Price/Option Resend",
  "short_name": "A21 Resend",
  "version": "0.4.5",
  "description": "A21 가격·옵션 직렬 전송과 B코드 품절/판매중 동기화. 옵션상품은 A6→A22, 단품은 A6→A21 판매상태송신으로 처리합니다.",
  "permissions": ["storage", "tabs", "windows", "scripting", "webNavigation", "debugger"],
  "host_permissions": [
    "https://a.shopling.co.kr/*",
    "https://commerce-os-ops-center.vercel.app/*"
  ],
  "background": {
    "service_worker": "background-v045.js"
  },
  "action": {
    "default_title": "Shopling A21 가격·옵션 수정전송",
    "default_popup": "popup-run.html"
  },
  "content_scripts": [
    {
      "matches": ["https://commerce-os-ops-center.vercel.app/*"],
      "js": ["ops-stock-bridge-v045.js"],
      "run_at": "document_idle"
    },
    {
      "matches": ["https://a.shopling.co.kr/*"],
      "exclude_matches": ["https://a.shopling.co.kr/prodlinkage/goods_mallMdfy_trsmt.phtml*"],
      "js": ["content-a21.js", "content-stock-state-v045.js"],
      "all_frames": true,
      "run_at": "document_idle"
    },
    {
      "matches": ["https://a.shopling.co.kr/prodlinkage/goods_mallMdfy_trsmt.phtml*"],
      "js": ["main-a21-v024.js"],
      "world": "MAIN",
      "all_frames": true,
      "run_at": "document_start"
    },
    {
      "matches": ["https://a.shopling.co.kr/prodlinkage/goods_mallMdfy_trsmt.phtml*"],
      "js": ["content-a21-v024.js", "content-stock-state-v045.js"],
      "all_frames": true,
      "run_at": "document_idle"
    }
  ]
}
