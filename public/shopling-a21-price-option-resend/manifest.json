{
  "manifest_version": 3,
  "name": "Commerce OS · Shopling A21 Price/Option Resend",
  "short_name": "A21 Resend",
  "version": "0.2.4",
  "description": "Shopling A21 판매가/옵션 직렬 안전전송. 배송정보는 실제 수정안함 라디오를 DOM 증거로 고정하고, 송신창이 닫히거나 이동해도 관련 결과창을 추적해 성공/실패를 확인합니다.",
  "permissions": ["storage", "tabs", "windows", "scripting", "webNavigation"],
  "host_permissions": [
    "https://a.shopling.co.kr/*",
    "https://commerce-os-ops-center.vercel.app/*"
  ],
  "background": {
    "service_worker": "background-v024.js"
  },
  "action": {
    "default_title": "Shopling A21 가격·옵션 수정전송",
    "default_popup": "popup-run.html"
  },
  "content_scripts": [
    {
      "matches": ["https://a.shopling.co.kr/*"],
      "exclude_matches": ["https://a.shopling.co.kr/prodlinkage/goods_mallMdfy_trsmt.phtml*"],
      "js": ["content-a21.js"],
      "all_frames": true,
      "run_at": "document_idle"
    },
    {
      "matches": ["https://a.shopling.co.kr/prodlinkage/goods_mallMdfy_trsmt.phtml*"],
      "js": ["main-a21-v024.js"],
      "world": "MAIN",
      "all_frames": true,
      "run_at": "document_start"
    },
    {
      "matches": ["https://a.shopling.co.kr/prodlinkage/goods_mallMdfy_trsmt.phtml*"],
      "js": ["content-a21-v024.js"],
      "all_frames": true,
      "run_at": "document_idle"
    }
  ]
}
