{
  "manifest_version": 3,
  "name": "Commerce OS Shopling Market Group Canary",
  "short_name": "Shopling Group Canary",
  "version": "0.2.0",
  "description": "신규상품 1개만 원장에서 확보하여 이미 완료된 채널은 제외하고 남은 DM/SM 채널을 Shopling 실제 수동 경로로 순차 검증합니다.",
  "permissions": ["storage"],
  "host_permissions": [
    "*://*.shopling.co.kr/*",
    "https://commerce-os-ops-center.vercel.app/*"
  ],
  "background": {
    "service_worker": "background-root.mjs"
  },
  "content_scripts": [
    {
      "matches": ["*://*.shopling.co.kr/*"],
      "js": ["content-group-canary.mjs"],
      "all_frames": true,
      "match_about_blank": true,
      "run_at": "document_idle"
    }
  ]
}
