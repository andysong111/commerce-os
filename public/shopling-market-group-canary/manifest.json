{
  "manifest_version": 3,
  "name": "Commerce OS Shopling Market Group Canary",
  "short_name": "Shopling Group Canary",
  "version": "0.2.1",
  "description": "신규상품 1개의 남은 DM/SM 채널만 이어서 처리하며 실제 Shopling 송신 결과 페이지에서만 성공/실패를 판정합니다.",
  "permissions": ["storage"],
  "host_permissions": [
    "*://*.shopling.co.kr/*",
    "https://commerce-os-ops-center.vercel.app/*"
  ],
  "background": {
    "service_worker": "background-root.mjs"
  },
  "content_scripts": [
    {
      "matches": ["*://*.shopling.co.kr/*"],
      "js": ["content-group-canary.mjs"],
      "all_frames": true,
      "match_about_blank": true,
      "run_at": "document_idle"
    }
  ]
}
