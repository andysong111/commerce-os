{
  "manifest_version": 3,
  "name": "Commerce OS Keyword Lab Collector",
  "short_name": "Keyword Lab",
  "version": "0.1.3",
  "description": "1688 실제 렌더링 화면에서 중국 상품 정보와 고정링크 오류 상태를 안정적으로 읽어 Commerce OS로 전달합니다.",
  "host_permissions": [
    "https://detail.1688.com/*",
    "https://*.1688.com/*",
    "https://commerce-os-ops-center.vercel.app/*",
    "https://*.vercel.app/*"
  ],
  "content_scripts": [
    {
      "matches": [
        "https://1688.com/*",
        "https://*.1688.com/*"
      ],
      "js": [
        "content-1688-audit-v013.js",
        "content-1688-recovery-v013.js",
        "content-1688-health.js",
        "content-1688.js"
      ],
      "run_at": "document_idle"
    },
    {
      "matches": [
        "https://commerce-os-ops-center.vercel.app/*",
        "https://*.vercel.app/*"
      ],
      "include_globs": [
        "https://commerce-os-ops-center.vercel.app/*",
        "https://commerce-os-ops-center-*.vercel.app/*"
      ],
      "js": ["content-ops.js"],
      "run_at": "document_idle"
    }
  ]
}
