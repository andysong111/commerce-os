{
  "manifest_version": 3,
  "name": "Commerce OS Shopling Account Title Bridge",
  "short_name": "Shopling Titles",
  "version": "0.2.1",
  "description": "Shopling 상품조회 메인 화면에서 현재 조회된 상품 전체의 미분산 goods key를 원버튼으로 자동 분산·저장·검증합니다.",
  "permissions": [
    "storage"
  ],
  "host_permissions": [
    "https://a.shopling.co.kr/*"
  ],
  "background": {
    "service_worker": "background-shopling-title-batch.js"
  },
  "content_scripts": [
    {
      "matches": [
        "https://a.shopling.co.kr/prod/prodShopInfo.phtml*"
      ],
      "js": [
        "content-shopling-account-titles.js"
      ],
      "run_at": "document_idle"
    },
    {
      "matches": [
        "https://a.shopling.co.kr/prod/*"
      ],
      "js": [
        "content-shopling-product-list-batch.js"
      ],
      "all_frames": true,
      "match_about_blank": true,
      "run_at": "document_idle"
    }
  ]
}
