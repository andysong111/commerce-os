{
  "manifest_version": 3,
  "name": "Commerce OS Shopling Account Title Bridge",
  "short_name": "Shopling Titles",
  "version": "0.4.0",
  "description": "Shopling 상품명 일괄 분산 후 DM1~SM2 미등록 상품을 저장검색 1:1 매핑으로 최대 2개 창에서 안전하게 마켓 전송합니다.",
  "permissions": [
    "storage"
  ],
  "host_permissions": [
    "https://a.shopling.co.kr/*",
    "https://commerce-os-ops-center.vercel.app/*"
  ],
  "background": {
    "service_worker": "background-shopling-root.js"
  },
  "content_scripts": [
    {
      "matches": [
        "https://a.shopling.co.kr/prod/prodShopInfo.phtml*"
      ],
      "js": [
        "content-shopling-account-titles.js"
      ],
      "run_at": "document_idle"
    },
    {
      "matches": [
        "https://a.shopling.co.kr/prod/*"
      ],
      "js": [
        "content-shopling-product-list-batch.js"
      ],
      "all_frames": true,
      "match_about_blank": true,
      "run_at": "document_idle"
    },
    {
      "matches": [
        "https://a.shopling.co.kr/*"
      ],
      "js": [
        "content-shopling-market-send.js"
      ],
      "all_frames": true,
      "match_about_blank": true,
      "run_at": "document_idle"
    }
  ]
}
