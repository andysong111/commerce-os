{
  "manifest_version": 3,
  "name": "Commerce OS Shopling Account Title Bridge",
  "short_name": "Shopling Titles",
  "version": "0.5.3",
  "description": "상품명 분산도 영구 원장으로 신규 goods key만 처리하고, 신규상품 마켓 송신은 기존 영구 잠금으로 중복등록을 차단합니다.",
  "permissions": [
    "storage"
  ],
  "host_permissions": [
    "https://a.shopling.co.kr/*",
    "https://commerce-os-ops-center.vercel.app/*"
  ],
  "background": {
    "service_worker": "background-shopling-root.js"
  },
  "content_scripts": [
    {
      "matches": [
        "https://a.shopling.co.kr/prod/prodShopInfo.phtml*"
      ],
      "js": [
        "content-shopling-account-titles.js"
      ],
      "run_at": "document_idle"
    },
    {
      "matches": [
        "https://a.shopling.co.kr/prod/*"
      ],
      "js": [
        "content-shopling-product-list-batch.js",
        "content-shopling-product-list-registry-bridge.js"
      ],
      "all_frames": true,
      "match_about_blank": true,
      "run_at": "document_idle"
    },
    {
      "matches": [
        "https://a.shopling.co.kr/*"
      ],
      "js": [
        "content-shopling-pipeline.js",
        "content-shopling-pipeline-frame-bridge.js"
      ],
      "all_frames": true,
      "match_about_blank": true,
      "run_at": "document_idle"
    }
  ]
}
