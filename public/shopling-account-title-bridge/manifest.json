{
  "manifest_version": 3,
  "name": "Commerce OS Shopling Account Title Bridge",
  "short_name": "Shopling Titles",
  "version": "0.2.0",
  "description": "Shopling 로그인 상태에서 상품목록의 미분산 goods key를 찾아 계정별 상품명을 자동 분산·저장·검증합니다.",
  "permissions": [
    "storage"
  ],
  "host_permissions": [
    "https://a.shopling.co.kr/*"
  ],
  "background": {
    "service_worker": "background-shopling-title-batch.js"
  },
  "content_scripts": [
    {
      "matches": [
        "https://a.shopling.co.kr/prod/*"
      ],
      "js": [
        "content-shopling-account-titles.js"
      ],
      "run_at": "document_idle"
    }
  ]
}
